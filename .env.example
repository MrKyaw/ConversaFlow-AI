# ---------------------------------------------------------------------------
# ConversaFlow runtime configuration
# Every value below has a safe default; nothing here is required to run the
# demo. Export overrides into the process environment; .env is not auto-loaded.
# ---------------------------------------------------------------------------

# Comma-separated API keys as key:tenant:role. Roles: admin | agent | viewer.
CONVERSAFLOW_API_KEYS=dev-key-123:demo:admin,demo-agent-key:demo:agent,readonly-key:demo:viewer

# Session + storage
CONVERSAFLOW_STORE=sqlite                 # memory | sqlite
CONVERSAFLOW_DB_PATH=var/conversaflow.db
CONVERSAFLOW_SESSION_TTL_SECONDS=3600
CONVERSAFLOW_MAX_TURNS=60

# NLU
CONVERSAFLOW_MODEL_PATH=models/nlu.json   # written by `conversaflow train`
CONVERSAFLOW_INTENT_THRESHOLD=0.30
CONVERSAFLOW_MARGIN_THRESHOLD=0.06

# Knowledge base
CONVERSAFLOW_KB_MIN_SCORE=1.5

# Guardrails
CONVERSAFLOW_RATE_LIMIT_PER_MINUTE=240
CONVERSAFLOW_REDACT_LOGS=true
CONVERSAFLOW_TOOL_TIMEOUT_SECONDS=3.0

# Reserved voice adapter settings (external adapters are not implemented)
CONVERSAFLOW_STT_URL=
CONVERSAFLOW_TTS_URL=
CONVERSAFLOW_VOICE_TIMEOUT_SECONDS=5.0

# Observability
CONVERSAFLOW_LOG_LEVEL=INFO
CONVERSAFLOW_LOG_FORMAT=json              # json | console
CONVERSAFLOW_DATA_DIR=data
